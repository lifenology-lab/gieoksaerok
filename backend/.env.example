# Django
SECRET_KEY=django-key
# 개발용 서버에서만 True로!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# OpenAI
OPENAI_API_KEY=sk-your-api-key
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_DIARIZATION_ENABLED=True
OPENAI_TRANSCRIPTION_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
OPENAI_TRANSCRIPTION_LANGUAGE=ko
OPENAI_PATIENT_QUESTION_CLASSIFICATION_MODEL=gpt-4o-mini
OPENAI_MEMORY_SUMMARY_MODEL=gpt-4o
OPENAI_MEMORY_SUMMARY_MAX_OUTPUT_TOKENS=700
PROMISE_DEFAULT_TIMEZONE=Asia/Seoul
PROMISE_EXPIRED_RETENTION_DAYS=30
# Database (배포 MySQL)
DB_ENGINE=mysql
DB_NAME=your_db_name_here
DB_USER=your_username_here
DB_PASSWORD=your_password_here
DB_HOST=your-db-endpoint.rds.amazonaws.com
DB_PORT=3306
